#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  comment-hygiene audit [--all] PATH...
  comment-hygiene strip [--all] --apply PATH...

Commands:
  audit  Preview AST-identified comments without changing files.
  strip  Remove comments in place. This requires explicit --apply confirmation.

Options:
  --all    Include documentation, TODO, and FIXME comments. Tool directives and
           comments protected with uncomment's ~keep marker remain protected.
  --apply  Required for strip because it writes files.
EOF
}

fail() {
  printf 'comment-hygiene: %s\n' "$*" >&2
  exit 2
}

command_name="${UNCOMMENT_BIN:-uncomment}"
command -v "$command_name" >/dev/null 2>&1 || fail \
  "uncomment is unavailable; run 'mise run setup' from the repository root first"

[[ $# -gt 0 ]] || {
  usage >&2
  exit 2
}

action="$1"
shift

all=false
apply=false
paths=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)
      all=true
      ;;
    --apply)
      apply=true
      ;;
    --)
      shift
      paths+=("$@")
      break
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --*)
      fail "unknown option: $1"
      ;;
    *)
      paths+=("$1")
      ;;
  esac
  shift
done

[[ ${#paths[@]} -gt 0 ]] || fail "provide at least one source path"

removal_flags=()
if "$all"; then
  removal_flags+=(--remove-doc --remove-todo --remove-fixme)
fi

case "$action" in
  audit)
    NO_COLOR=1 "$command_name" --dry-run --verbose --diff \
      "${removal_flags[@]}" -- "${paths[@]}"
    ;;
  strip)
    "$apply" || fail "strip writes files; rerun with --apply after reviewing audit output"
    "$command_name" "${removal_flags[@]}" -- "${paths[@]}"
    ;;
  --help|-h)
    usage
    ;;
  *)
    fail "unknown command: $action"
    ;;
esac
